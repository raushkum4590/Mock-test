{
  "name": "cbt-exam-system",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-based test platform for SSC-style mock examinations (Next.js + PostgreSQL/Neon)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "cloudinary:check": "tsx scripts/cloudinary-check.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "sync:push": "tsx scripts/sync-push.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mock:series": "tsx scripts/seed-mock-series.ts",
    "mock:tally": "tsx scripts/seed-tally-payroll.ts",
    "mock:html": "tsx scripts/seed-html-basics.ts",
    "mock:tally-cost-centre": "tsx scripts/seed-tally-cost-centre.ts",
    "ca:backfill": "tsx scripts/current-affairs/backfill.ts",
    "ca:build": "tsx scripts/current-affairs/build.ts",
    "ca:pdf": "tsx scripts/current-affairs/pdf.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sucrase": "^3.35.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.19.1",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
