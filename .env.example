# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Profile A (connected centre): Neon connection string. Use the *pooled*
# host (contains "-pooler") and use sslmode=verify-full (pg treats "require" as verify-full today).
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/cbt?sslmode=verify-full
# Profile B (offline centre): local PostgreSQL, e.g. the one started by
# `npm run db:local`:
DATABASE_URL=postgresql://cbt:change-me@127.0.0.1:5433/cbt
# Max connections in the server's pool.
DATABASE_POOL_MAX=10

# Password for the embedded local PostgreSQL started by `npm run db:local`.
LOCAL_PG_PASSWORD=change-me
LOCAL_PG_PORT=5433

# --- Security ---------------------------------------------------------------
# Long random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=replace-with-a-long-random-secret
# One-time token required by the web-based first administrator setup at /setup.
# Leave empty to disable web setup and use `npm run admin:create` instead.
SETUP_TOKEN=
# "auto" = Secure cookies only when APP_BASE_URL is https. LAN centres served
# over plain http must not force Secure cookies or logins will silently fail.
COOKIE_SECURE=auto
# Extra origins allowed to send state-changing requests (comma separated).
ALLOWED_ORIGINS=

# --- Application ------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
EXAM_TIME_ZONE=Asia/Kolkata

# Scheduler: "embedded" runs inside the Next.js server process (simplest).
# "external" expects `npm run scheduler` as a separate supervised process.
# Both may run at the same time safely (state transitions are idempotent).
SCHEDULER_MODE=embedded
SCHEDULER_INTERVAL_MS=1000

# Exam photos (photo before login, start/end-of-exam photos) are uploaded to
# Cloudinary. Required for schedules with "Photo before login" or "Camera
# monitoring" turned on; candidates cannot log in to such a sitting without it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=edqity/exam-photos
